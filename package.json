    "lucide-react": "^0.562.0",
    "motion": "^12.40.0",
    "nodemailer": "^8.0.10",
    "pg": "^8.21.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "twilio": "^6.0.2",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^22.14.0",
    "@types/nodemailer": "^8.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "esbuild": "^0.28.0",
